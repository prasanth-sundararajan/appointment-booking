# Copy to .env and fill in. Never commit .env.

# ---------- Database (docker compose) ----------
POSTGRES_USER=slotease
POSTGRES_PASSWORD=change-me
POSTGRES_DB=slotease

# ---------- Core ----------
# Local (non-docker) runs. Compose files override this to point at the `db` service.
DATABASE_URL=postgresql://slotease:change-me@localhost:5432/slotease
SECRET_KEY=change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173
WEB_CONCURRENCY=2

# ---------- Google (login + calendar) ----------
GOOGLE_CLIENT_ID=your-client-id
GOOGLE_CLIENT_SECRET=your-secret
GOOGLE_LOGIN_REDIRECT_URI=http://localhost:8000/auth/google/callback
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:8000/api/calendar/google/callback
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=fernet-key-base64

# ---------- Dodo Payments ----------
DODO_API_KEY=your-dodo-key
DODO_WEBHOOK_SECRET=your-webhook-secret
DODO_DEPOSIT_PRODUCT_ID=
# Optional per-currency PWYW product (amount is charged in the product currency):
# DODO_DEPOSIT_PRODUCT_ID_EUR=
DODO_ENVIRONMENT=test_mode

# ---------- Booking defaults ----------
DEFAULT_DEPOSIT_PERCENT=15
MIN_DEPOSIT_PERCENT=10
DEFAULT_CANCELLATION_CUTOFF_HOURS=8
HOLD_MINUTES=10

# ---------- Rate limiting ----------
# slowapi/limits storage. memory:// is per worker process (fine for local dev); with
# several gunicorn workers use a shared store. docker-compose.prod.yml sets
# redis://redis:6379/0 for the backend automatically.
RATE_LIMIT_STORAGE_URI=memory://

# ---------- Email ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@yourdomain.com

# ---------- Frontend (build-time) ----------
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000

# ---------- Production (server .env only) ----------
DOMAIN=yourdomain.com
CERTBOT_EMAIL=admin@yourdomain.com
